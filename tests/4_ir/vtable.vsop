class Animal {
    speak() : string {"..."}
}
class Dog extends Animal {
    speak() : string { "Woof" }
}
class Cat extends Animal {
    speak() : string { "Meow" }
}
class Main {
    main() : int32 {
        let a : Animal <- new Dog in {
            print(a.speak());
            print("\n");
            0
        }
    }
}